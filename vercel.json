{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/:path*.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/app.bundle.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    { "source": "/episodes/index.html", "destination": "/episodes/", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/episodes/20-andy-miller", "destination": "/episodes/19-andy-miller/", "permanent": true },
    { "source": "/episodes/20-andy-miller/", "destination": "/episodes/19-andy-miller/", "permanent": true },
    { "source": "/episodes/25-nam-nguyen", "destination": "/episodes/24-nam-nguyen/", "permanent": true },
    { "source": "/episodes/25-nam-nguyen/", "destination": "/episodes/24-nam-nguyen/", "permanent": true },
    { "source": "/episodes/26-celeste-amadon", "destination": "/episodes/25-celeste-amadon/", "permanent": true },
    { "source": "/episodes/26-celeste-amadon/", "destination": "/episodes/25-celeste-amadon/", "permanent": true },
    { "source": "/episodes/28-shakeel-lala", "destination": "/episodes/27-shakeel-lala/", "permanent": true },
    { "source": "/episodes/28-shakeel-lala/", "destination": "/episodes/27-shakeel-lala/", "permanent": true }
  ]
}
